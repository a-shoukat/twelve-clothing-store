# Supabase project credentials (get these from your Supabase dashboard:
# Project Settings -> API). Never commit real values to git.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Store contact details used on the public site.
# WhatsApp number in international format WITHOUT "+" (e.g. 923001234567)
VITE_STORE_WHATSAPP=923001234567
VITE_STORE_INSTAGRAM=https://www.instagram.com/twelveclothing
